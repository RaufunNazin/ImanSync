{
  "cli": {
    "version": ">= 7.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "abiFilter": [
          "arm64-v8a"
        ]
      },
      "channel": "preview"
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "abiFilter": [
          "arm64-v8a"
        ]
      },
      "channel": "production"
    },
    "production": {
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
